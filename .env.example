# Copy this file to .env.local and fill in your keys.
ANTHROPIC_API_KEY=sk-ant-...

# Natural voice (recommended). Without it, the browser's best local voice is used.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...          # voice for high school / college / expert (from your ElevenLabs voice library)
# ELEVENLABS_VOICE_ID_YOUNG=...    # optional: a younger-sounding voice for kindergarten / middle school
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: override the Claude models
# SMART_MODEL=claude-sonnet-5-5    # concept extraction + feedback
# FAST_MODEL=claude-haiku-5-5      # live replies, evaluation, verification

# L2T Daily (shared leaderboard). In production, use Redis over REST so every
# server instance shares one leaderboard: Upstash, or Vercel KV (same API).
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
#   (or KV_REST_API_URL / KV_REST_API_TOKEN from Vercel KV)
# Without Redis, scores go to a JSON file on the server (fine for `npm run dev`):
# DAILY_DATA_FILE=.data/l2t-daily.json
# Signs attempts and user ids. Defaults to a key derived from ANTHROPIC_API_KEY.
# DAILY_SECRET=a-long-random-string
